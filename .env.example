# Copy to .env for local runs. Never commit .env.
# Base URL of the MWIS instance under test (dev repo README: bin/rails server -p 3100).
MWIS_BASE_URL=http://localhost:3100

# An ACTIVE System Admin on that instance. Use a dedicated, non-sensitive test account.
MWIS_ADMIN_EMAIL=
MWIS_ADMIN_PASSWORD=
